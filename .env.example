# ===========================================
# AHS Signatures - Environment Configuration
# ===========================================

# Backend Configuration
# ---------------------
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ahs_signatures
JWT_SECRET=change-this-secret-in-production
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TOKEN_EXPIRY_HOURS=72

# Email Configuration
# -------------------
# Provider: 'sendgrid' or 'smtp'
EMAIL_PROVIDER=smtp

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# SMTP (if EMAIL_PROVIDER=smtp)
# For local dev with MailHog (see backend/.env.example for all settings):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Email settings
EMAIL_FROM=signatures@example.com
EMAIL_FROM_NAME=AHS Signatures
ADMIN_EMAIL=admin@example.com

# Frontend Configuration
# ----------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
