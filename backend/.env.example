# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL). Schema is created/upgraded by `npm run db:migrate`
# (runs automatically on container start).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ahs_signatures

# Auth - MUST be a long random value in production
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=24h

# Initial admin account (created on start if it doesn't exist; 12+ char password in production)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Admin

# CORS / links
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Token expiry in hours
TOKEN_EXPIRY_HOURS=72

# Timezone for dates stamped on signed documents
TIMEZONE=America/New_York

# Email Provider: 'sendgrid' or 'smtp'
EMAIL_PROVIDER=smtp
SENDGRID_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=signatures@example.com
EMAIL_FROM_NAME=AHS Signatures
ADMIN_EMAIL=admin@example.com

# Google Drive (form route pulls)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JotForm
JOTFORM_WEBHOOK_SECRET=

# SharePoint (Microsoft Graph)
SHAREPOINT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_SITE_URL=
SHAREPOINT_LIBRARY_NAME=Documents
SHAREPOINT_BASE_FOLDER=Signed Documents
