generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Admin/staff users who can create and manage signing packets
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("user") // "admin" or "user"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  @@index([email])
}

// A signing packet with its own uploaded PDF document
model SigningPacket {
  id              String   @id @default(uuid())
  name            String
  fileName        String   // Original uploaded file name
  filePath        String   // Storage path: packets/{id}/{filename}
  placeholders    String   // JSON string of detected placeholders
  status          String   @default("draft") // draft, pending_assignment, sent, in_progress, completed, cancelled
  signedPdfPath   String?  // Path to final signed PDF
  sharepointUrl   String?  // SharePoint URL where signed PDF was uploaded
  sharepointFolder String? // SharePoint folder name the document was placed into
  sharepointError String?  // Error message if SharePoint upload failed
  employeeName    String?  // Employee who filled the JotForm (for SharePoint upload)
  employeeEmail   String?  // Employee email from JotForm
  formRouteId     String?  // Link to FormRoute if created via webhook
  county          String?  // Location/address from JotForm (city, state)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?
  recipients      Recipient[]
  auditLogs       AuditLog[]
}

// A recipient/signer for a packet
model Recipient {
  id            String   @id @default(uuid())
  packetId      String
  packet        SigningPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  roleName      String   // matches placeholder role
  name          String
  email         String
  order         Int      // signing order (1, 2, 3...)
  status        String   @default("pending") // pending, notified, signed, skipped
  token         String   @unique // secure signing token
  tokenExpiresAt DateTime
  signedAt      DateTime?
  signature     Signature?
  auditLogs     AuditLog[]

  @@index([token])
}

// Stored signature data (I-9 compliant electronic signature record)
model Signature {
  id              String   @id @default(uuid())
  recipientId     String   @unique
  recipient       Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  signatureData   String   // Base64 image data or typed text
  signatureType   String   // "drawn" or "typed"
  typedName       String?  // Name typed by signer
  textFields      String?  // JSON string of additional text field values
  ipAddress       String?
  userAgent       String?
  attestationText String?  // Exact attestation text the signer acknowledged
  identityRecord  String?  // JSON: { email, name, tokenHash, ip, userAgent, signedAt }
  createdAt       DateTime @default(now())
}

// JotForm-to-signer routing configuration
model FormRoute {
  id              String   @id @default(uuid())
  jotformFormId   String   @unique   // JotForm form ID
  formName        String              // Human-readable name (e.g., "TB Test Form")
  signerEmail     String?             // Countersigner email (null = manual assignment)
  signerName      String?             // Countersigner name (null = manual assignment)
  signerRole      String   @default("countersigner") // Role name for placeholder matching
  driveFolderId   String?             // Google Drive folder ID for pulling submission PDFs
  sharepointFolder String?            // Optional SharePoint subfolder for this form type
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Tracks which submissions/files have already been processed
model ProcessedSubmission {
  id           String   @id @default(uuid())
  submissionId String   @unique // JotForm submission ID or Google Drive file ID
  formId       String            // JotForm form ID or form route ID
  packetId     String?           // Resulting SigningPacket ID
  driveFileId  String?           // Google Drive file ID (for Drive-sourced files)
  processedAt  DateTime @default(now())

  @@index([formId])
  @@index([driveFileId])
}

// Key-value store for system settings (OAuth tokens, etc.)
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Cached SharePoint folder data (avoids repeated API scans of large folder trees)
model SharePointFolderCache {
  id           String   @id @default(uuid())
  folderId     String   // SharePoint folder ID
  name         String   // Folder name (usually employee name)
  webUrl       String   @default("")
  childCount   Int      @default(0)
  path         String   // Full path in SharePoint
  parentFolder String   @default("") // Parent path (base folder / subfolder)
  cacheKey     String   // The search path used to find this folder (for cache grouping)
  cachedAt     DateTime @default(now())

  @@index([cacheKey])
  @@index([name])
}

// Audit log for tracking events
model AuditLog {
  id          String   @id @default(uuid())
  packetId    String
  packet      SigningPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   Recipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  action      String   // created, sent, viewed, signed, completed, resent, etc.
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}
